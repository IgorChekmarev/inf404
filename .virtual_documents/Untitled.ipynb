import heapq

n, m, s, f = map(int, input().split())

graph = [[] for _ in range(n)]

for _ in range(m):
    u, v, w = map(int, input().split())
    graph[u].append((v, w))
    graph[v].append((u, w))

INF = 10**18
dist = [INF] * n
dist[s] = 0

pq = [(0, s)]

while pq:
    d, u = heapq.heappop(pq)

    if d != dist[u]:
        continue

    if u == f:
        break

    for v, w in graph[u]:
        nd = d + w
        if nd < dist[v]:
            dist[v] = nd
            heapq.heappush(pq, (nd, v))

print(dist[f])


