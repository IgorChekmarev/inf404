Ввод	
print(*accumulate([7, -1, 15, 2]))
Вывод
7 6 21 23



def accumulate(iterable):
    it = iter(iterable)
    try:
        total = next(it)
    except StopIteration:
        return
    yield total
    for x in it:
        total = total + x
        yield total




print(*accumulate(range(1, 5)))


Напишите декоратор cache(form) , который сохраняет информацию о предыдущих вызовах функций от нескольких позиционных параметров.

Примеры
Ввод	
@cache
def func(n):
    print('n =', n)
    return 1 if n < 2 else n + func(n-1)
print(func(5))
print(func(7))
Вывод
n = 5
n = 4
n = 3
n = 2
n = 1
15
n = 7
n = 6
28



from functools import wraps

def cache(func):
    memo = {}

    @wraps(func)
    def wrapper(*args, **kwargs):
        key = (args, tuple(sorted(kwargs.items())))
        if key not in memo:
            memo[key] = func(*args, **kwargs)
        return memo[key]

    return wrapper


@cache
def func(n):
    print('n =', n)
    return 1 if n < 2 else n + func(n-1)
print(func(5))
print(func(7))






